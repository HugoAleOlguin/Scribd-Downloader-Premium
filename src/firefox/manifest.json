{
  "manifest_version": 3,
  "name": "Scribd Downloader",
  "version": "5.0.0",
  "description": "Descarga documentos de Scribd como PDF directamente desde el navegador. Sin APIs externas.",
  "permissions": [
    "activeTab",
    "downloads",
    "storage",
    "cookies"
  ],
  "host_permissions": [
    "*://*.scribd.com/*",
    "*://*.scribdassets.com/*"
  ],
  "background": {
    "scripts": ["background.js"],
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16":  "icons/icon16.png",
      "32":  "icons/icon32.png",
      "48":  "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16":  "icons/icon16.png",
    "32":  "icons/icon32.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["*://*.scribd.com/*"],
      "js": ["key-interceptor.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["*://*.scribd.com/*"],
      "all_frames": false,
      "js": [
        "libs/shim.js",
        "libs/i18n.js",
        "services/pdfApi.js",
        "content.js"
      ],
      "css": ["overlay.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "libs/shim.js",
        "libs/i18n.js",
        "icons/icon128.png",
        "icons/icon48.png",
        "icons/icon32.png"
      ],
      "matches": ["*://*.scribd.com/*"]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "scribd-downloader@extension"
    }
  }
}